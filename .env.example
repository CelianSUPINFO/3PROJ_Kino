# Copy to .env at repo root (used by docker compose) or per-app (see README)

# --- Database ---
POSTGRES_USER=kino
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=kino
DATABASE_URL=postgresql://kino:change-me-db-password@localhost:5432/kino

# --- API (apps/api or docker compose) ---
PORT=4000
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_DAYS=14
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/v1/auth/google/callback
MOBILE_OAUTH_SCHEME=kino
REDIS_URL=redis://localhost:6379

# --- Web (build-time) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# --- Mobile (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:4000/v1
