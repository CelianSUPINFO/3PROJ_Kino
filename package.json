{
  "name": "kino-supcontent",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w api",
    "dev:web": "npm run dev -w web",
    "dev:mobile": "npm run start --prefix apps/mobile",
    "build:api": "npm run build -w api",
    "build:web": "npm run build -w web",
    "typecheck:mobile": "npx tsc --noEmit -p apps/mobile/tsconfig.json",
    "test:web": "npm run test -w web",
    "test:mobile": "npm run test --prefix apps/mobile",
    "verify": "npm run build:api && npm run build:web && npm run typecheck:mobile && npm run test:web && npm run test:mobile && npm run test:e2e -w api -- --runInBand"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.26",
    "@nestjs/core": "^11.1.26",
    "@nestjs/platform-express": "^11.1.26",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  }
}
