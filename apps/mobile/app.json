{
  "expo": {
    "name": "Kino",
    "slug": "kino-supcontent",
    "scheme": "kino",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cultureconnect.kino",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05060B"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cultureconnect.kino",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiUrl": "https://kino-api-9ipb.onrender.com/v1",
      "eas": {
        "projectId": "8411e29d-9f87-49a6-8abc-01c838252115"
      }
    },
    "plugins": [
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kino utilise votre galerie pour choisir une photo de profil ou une bannière.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#05060B"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/8411e29d-9f87-49a6-8abc-01c838252115"
    },
    "owner": "astartare"
  }
}
